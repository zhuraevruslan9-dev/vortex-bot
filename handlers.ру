import base64
from telegram import Update
from telegram.ext import ContextTypes
from telegram.ext import CommandHandler
from telegram.ext import MessageHandler
from telegram.ext import CallbackQueryHandler
from telegram.ext import filters
from config import CRYPTO_SYMBOLS
from database import set_user_asset
from database import get_user_asset
from database import update_user_price
from binance_service import get_price
from openai_service import chat_with_ai
from openai_service import analyze_image
from openai_service import market_overview
from keyboards import main_menu
from keyboards import crypto_inline
async def start(update, context):
    await update.message.reply_text(
        "Hello! I am Vortex. Choose action below",
        reply_markup=main_menu
    )
async def track_asset(update, context):
    await update.message.reply_text(
        "Choose cryptocurrency:",
        reply_markup=crypto_inline
    )
async def process_asset(update, context):
    query = update.callback_query
    await query.answer()
    asset_name = query.data.replace("asset_", "")
    symbol = CRYPTO_SYMBOLS[asset_name]
    await set_user_asset(
        query.from_user.id,
        asset_name,
        query.message.chat.id
    )
    data = await get_price(symbol)
    await update_user_price(query.from_user.id, data["price"])
    await query.message.reply_text(
        f"Tracking {asset_name}\n"
        f"Price: ${data['price']:,.2f}\n"
        f"24h: {data['change_percent']:+.2f}%\n\n"
        f"I will notify if price changes > 2%"
    )
async def market_summary(update, context):
    await update.message.reply_text("Collecting market data...")
    prices = {}
    for name, symbol in CRYPTO_SYMBOLS.items():
        data = await get_price(symbol)
        prices[name] = (
            f"${data['price']:,.2f} "
            f"({data['change_percent']:+.2f}%)"
        )
    overview = await market_overview(prices)
    await update.message.reply_text(overview)
async def ask_for_image(update, context):
    await update.message.reply_text(
        "Send chart screenshot for analysis"
    )
async def analyze_chart(update, context):
    await update.message.reply_text("Analyzing chart...")
    photo = update.message.photo[-1]
    file = await context.bot.get_file(photo.file_id)
    file_obj = await file.download_as_bytearray()
    image_bytes = bytes(file_obj)
    image_base64 = base64.b64encode(image_bytes).decode("utf-8")
    analysis = await analyze_image(image_base64)
    await update.message.reply_text(analysis)
async def ask_ai_mode(update, context):
    await update.message.reply_text("Ask a question!")
async def any_message(update, context):
    menu = [
        "📈 Track asset",
        "📊 Market overview",
        "🖼 Chart analysis",
        "💬 Ask AI"
    ]
    if update.message.text not in menu:
        await update.message.reply_text("Thinking...")
        answer = await chat_with_ai(update.message.text)
        await update.message.reply_text(answer)
def register_handlers(application):
    application.add_handler(CommandHandler("start", start))
    application.add_handler(
        MessageHandler(filters.Text(["📈 Track asset"]), track_asset)
    )
    application.add_handler(
        MessageHandler(filters.Text(["📊 Market overview"]), market_summary)
    )
    application.add_handler(
        MessageHandler(filters.Text(["🖼 Chart analysis"]), ask_for_image)
    )
    application.add_handler(
        MessageHandler(filters.Text(["💬 Ask AI"]), ask_ai_mode)
    )
    application.add_handler(
        CallbackQueryHandler(process_asset, pattern="^asset_")
    )
    application.add_handler(
        MessageHandler(filters.PHOTO, analyze_chart)
    )
    application.add_handler(
        MessageHandler(filters.TEXT & ~filters.COMMAND, any_message)
    )
