import base64
from telegram import Update
from telegram.ext import ContextTypes, CommandHandler, MessageHandler, CallbackQueryHandler, filters

from config import CRYPTO_SYMBOLS
from database import set_user_asset, get_user_asset, update_user_price
from binance_service import get_price
from openai_service import chat_with_ai, analyze_image, market_overview
from keyboards import main_menu, crypto_inline

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "🌪️ <b>Привет! Я Vortex</b>\n\n"
        "Твой умный помощник в мире криптовалют. Выбери действие ниже 👇",
        reply_markup=main_menu,
        parse_mode="HTML"
    )

async def track_asset(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("Выбери криптовалюту:", reply_markup=crypto_inline)

async def process_asset(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    
    asset_name = query.data.replace("asset_", "")
    symbol = CRYPTO_SYMBOLS[asset_name]
    
    await set_user_asset(query.from_user.id, asset_name, query.message.chat.id)
    
    data = await get_price(symbol)
    await update_user_price(query.from_user.id, data["price"])
    
    await query.message.reply_text(
        f"✅ Отслеживаю <b>{asset_name}</b>\n"
        f"💰 Цена: <b>${data['price']:,.2f}</b>\n"
        f"📊 24ч: <b>{data['change_percent']:+.2f}%</b>\n\n"
        f"Пришлю уведомление, если цена изменится больше чем на 2% 📡",
        parse_mode="HTML"
    )

async def market_summary(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("⏳ Собираю данные с рынка...")
    
    prices = {}
    for name, symbol in CRYPTO_SYMBOLS.items():
        data = await get_price(symbol)
        prices[name] = f"${data['price']:,.2f} ({data['change_percent']:+.2f}%)"
    
    overview = await market_overview(prices)
    await update.message.reply_text(overview, parse_mode="HTML")

async def ask_for_image(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("Пришли скриншот графика — я разберу, что там происходит 📈")

async def analyze_chart(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("🔍 Смотрю на график...")
    
    photo = update.message.photo[-1]
    file = await context.bot.get_file(photo.file_id)
    
    file_obj = await file.download_as_bytearray()
    image_bytes = bytes(file_obj)
    image_base64 = base64.b64encode(image_bytes).decode("utf-8")
    
    analysis = await analyze_image(image_base64)
    await update.message.reply_text(analysis, parse_mode="HTML")

async def ask_ai_mode(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("Напиши вопрос — я отвечу! 🧠")

async def any_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    menu_buttons = ["📈 Отслеживать актив", "📊 Рыночный обзор", 
                    "🖼 Анализ графика", "💬 Задать вопрос ИИ"]
    
    if update.message.text not in menu_buttons:
        await update.message.reply_text("⏳ Думаю...")
        answer = await chat_with_ai(update.message.text)
        await update.message.reply_text(answer, parse_mode="HTML")

def register_handlers(application):
    application.add_handler(CommandHandler("start", start))
    application.add_handler(MessageHandler(filters.Text(["📈 Отслеживать актив"]), track_asset))
    application.add_handler(MessageHandler(filters.Text(["📊 Рыночный обзор"]), market_summary))
    application.add_handler(MessageHandler(filters.Text(["🖼 Анализ графика"]), ask_for_image))
    application.add_handler(MessageHandler(filters.Text(["💬 Задать вопрос ИИ"]), ask_ai_mode))
    application.add_handler(CallbackQueryHandler(process_asset, pattern="^asset_"))
    application.add_handler(MessageHandler(filters.PHOTO, analyze_chart))
    application.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, any_message))
